<Project>
  <PropertyGroup>
    <SomeEngineRepositoryRoot Condition="'$(SomeEngineRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\</SomeEngineRepositoryRoot>

    <DiligentUseLocalBuild Condition="'$(DiligentUseLocalBuild)' == ''">false</DiligentUseLocalBuild>
    <DiligentPackageVersion Condition="'$(DiligentPackageVersion)' == ''">2.5.6-api13-local</DiligentPackageVersion>
    <DiligentSharpGenRuntimeVersion Condition="'$(DiligentSharpGenRuntimeVersion)' == ''">2.0.3-local</DiligentSharpGenRuntimeVersion>

    <DiligentConfiguration Condition="'$(DiligentConfiguration)' == ''">$(Configuration)</DiligentConfiguration>
    <DiligentConfiguration Condition="'$(DiligentConfiguration)' == ''">Debug</DiligentConfiguration>
    <DiligentLocalManagedTfm Condition="'$(DiligentLocalManagedTfm)' == ''">net6.0</DiligentLocalManagedTfm>
    <DiligentLocalBuildRoot Condition="'$(DiligentLocalBuildRoot)' == ''">$(SomeEngineRepositoryRoot)external\DiligentCore\build\.NET\Graphics\GraphicsEngine.NET</DiligentLocalBuildRoot>
  </PropertyGroup>
</Project>
