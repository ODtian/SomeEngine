<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UsesDiligentEngine>true</UsesDiligentEngine>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SomeEngine.Render\SomeEngine.Render.csproj" />
    <ProjectReference Include="..\SomeEngine.Core\SomeEngine.Core.csproj" />
    <ProjectReference Include="..\SomeEngine.Assets\SomeEngine.Assets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
    <PackageReference Include="DiligentGraphics.DiligentEngine.Core" Version="$(DiligentPackageVersion)" Condition="'$(DiligentUseLocalBuild)' != 'true'" />
    <PackageReference Include="Diligent-SharpGen.Runtime" Version="$(DiligentSharpGenRuntimeVersion)" Condition="'$(DiligentUseLocalBuild)' == 'true'" />
  </ItemGroup>

</Project>
